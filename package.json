{
  "name": "modiqueps-discord-moderation",
  "version": "1.1.0",
  "description": "A secure, scalable, open-source Discord moderation bot for ModiQuePS.",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "node --watch ./src/index.js",
    "shard": "node ./src/shard.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "moderation",
    "modiqueps"
  ],
  "author": "ModiQuePS",
  "license": "GPL-3.0-only",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.8.0",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.0"
  }
}
